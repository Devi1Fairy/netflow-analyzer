{
    // VS Code调试配置文件的格式版本。
    "version": "0.2.0",

    "configurations": [
        {
            // 显示在“运行和调试”下拉列表中的名称。
            "name": "Debug netflow-analyzer (CodeLLDB)",

            // 使用已经安装的CodeLLDB扩展。
            "type": "lldb",

            // launch表示由调试器启动一个新的主程序进程。
            "request": "launch",

            // 调试CMake生成的正式主程序，而不是单独的C源文件。
            "program": "${workspaceFolder}/build/bin/netflow-analyzer",

            // 当前不传参数，因此程序会执行默认的帮助命令。
            // 调试版本功能时，可以临时改成["--version"]。
            "args": [],

            // 程序的运行工作目录设为项目根目录。
            "cwd": "${workspaceFolder}",

            // 输出发送到调试控制台，适合当前不需要键盘输入的程序。
            "terminal": "console",

            // 不在程序入口自动暂停，而是运行到用户设置的断点。
            "stopOnEntry": false,

            // 启动调试器前先完成CMake配置和编译。
            "preLaunchTask": "CMake: Build Debug"
        }
    ]
}
